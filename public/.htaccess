<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ———————————————————————
  # 🔄 Redirecionamento 301 do ads.txt para Ezoic
  # ———————————————————————
  RewriteRule ^ads\.txt$ https://srv.adstxtmanager.com/19390/beijodarua.com.br [R=301,L]

  # ———————————————————————
  # ✅ Não redirecionar arquivos ou diretórios reais
  # ———————————————————————
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ———————————————————————
  # ✅ Proteger arquivos estáticos essenciais de redirecionamento
  # ———————————————————————
  RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico|apple-touch-icon\.png|og-image\.(jpg|png)|\.well-known/|google.+\.html)$ - [L]

  # ———————————————————————
  # 🌐 Redirecionar todas as demais rotas para index.html (SPA)
  # ———————————————————————
  RewriteRule ^ index.html [L]
</IfModule>
