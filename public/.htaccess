# ===========================================================
# Beijo da Rua – .htaccess
# SEO + SPA + limpeza de URLs legadas
# ===========================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ———————————————————————
  # 🔁 Forçar HTTPS
  # ———————————————————————
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ———————————————————————
  # 🔁 Forçar non-www (canônica = beijodarua.com.br)
  # ———————————————————————
  RewriteCond %{HTTP_HOST} ^www\.beijodarua\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://beijodarua.com.br/$1 [L,R=301]

  # ———————————————————————
  # 🚫 410 Gone para URLs legadas do site antigo (ASP / PDFs)
  # Evita "Soft 404" e "Não encontrado" no Search Console
  # ———————————————————————
  RewriteRule ^materia\.asp - [G,L]
  RewriteRule ^main\.asp - [G,L]
  RewriteRule \.asp$ - [G,L]
  RewriteRule ^(setembro|agosto|abril|maio|junho|julho|janeiro|fevereiro|marco|outubro|novembro|dezembro)[0-9]{4}\.pdf$ - [G,L]

  # ———————————————————————
  # 🔁 Consolidar URLs alternativas de artigos para a versão canônica /blog/posts/
  # Evita conteúdo duplicado e "Cópia sem página canônica selecionada" no Search Console
  # ———————————————————————
  RewriteRule ^blog/(cantadas-irresistiveis-que-funcionam|como-abordar-uma-mulher-com-confianca|os-segredos-de-um-perfil-conquistador|como-convidar-mulher-sair-sem-parecer-desesperado|tecnicas-controlar-nervosismo-paquera|frases-de-efeito-que-deixam-mulher-interessada|como-criar-conexoes-reais-em-apps|erros-fatais-que-destroem-seu-charme|descubra-qual-site-relacionamento-combina|linguagem-corporal-poderosa-na-hora-de-conquistar|estrategias-primeiro-encontro|como-ser-autentico-e-atraente-ao-mesmo-tempo|o-poder-do-silencio|domine-suas-emocoes-e-atraia|vibe-conquista-sem-dizer-palavra|melhores-apps-relacionamento-2026|sinais-interesse-feminino|escutar-nova-forma-conquistar|medo-coragem-conquistar-respeito|despertar-interesse-sem-dizer-nada|arte-manter-conversa-leve-envolver|humor-inteligente-conquista-mais-que-beleza|como-reconhecer-se-ela-esta-disponivel-emocionalmente|criar-expectativa-sem-parecer-jogador)/?$ /blog/posts/$1/ [L,R=301]
  RewriteRule ^criar-expectativa-sem-parecer-jogador/?$ /blog/posts/criar-expectativa-sem-parecer-jogador/ [L,R=301]

  # 🔁 Redirecionar URLs antigas do interior quiz para URLs SEO long-tail
  RewriteRule ^interior-quiz-2/?$ /experiencia-com-apps-de-namoro-cidades-interior/ [L,R=301]
  RewriteRule ^interior-quiz-3/?$ /mobilidade-para-encontros-apps-namoro-interior/ [L,R=301]
  RewriteRule ^interior-quiz-4/?$ /objetivo-relacionamento-apps-namoro-interior/ [L,R=301]
  RewriteRule ^interior-quiz-5/?$ /estilo-de-vida-apps-de-namoro-interior/ [L,R=301]

  # ———————————————————————
  # ✅ Não redirecionar arquivos ou diretórios reais existentes
  # ———————————————————————
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ———————————————————————
  # ✅ Proteger arquivos estáticos essenciais
  # ———————————————————————
  RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico|favicon\.png|apple-touch-icon\.png|og-image\.(jpg|png|webp)|manifest\.json|browserconfig\.xml|site\.webmanifest|ads\.txt|sw\.js)$ - [L]

  # ———————————————————————
  # ✅ Proteger arquivos de verificação
  # ———————————————————————
  RewriteRule ^google[a-zA-Z0-9]*\.html$ - [L]
  RewriteRule ^(BingSiteAuth\.xml|yandex_[a-zA-Z0-9]+\.html|pinterest-[a-zA-Z0-9]+\.html)$ - [L]
  RewriteRule ^\.well-known/ - [L]

  # ———————————————————————
  # ✅ Proteger arquivos estáticos por extensão
  # ———————————————————————
  RewriteRule \.(js|css|map|json|xml|txt|ico|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot|otf|mp4|webm|ogg|mp3|wav|pdf|zip)$ - [L]

  # ———————————————————————
  # 🔁 Forçar trailing slash (canônica padrão do site)
  # Não aplica a arquivos com extensão nem ao root.
  # ———————————————————————
  RewriteCond %{REQUEST_URI} !(/$|\.[a-zA-Z0-9]+$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)$ /$1/ [L,R=301]

  # ———————————————————————
  # 🌐 SPA fallback → index.html
  # ———————————————————————
  RewriteRule ^ index.html [L]
</IfModule>

# ===========================================================
# 🚫 Bloquear listagem explícita em diretórios de app/blog
# (caso o servidor tente servir índice de pasta vazia)
# ===========================================================
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>
